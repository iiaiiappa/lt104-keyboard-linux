# LangTu LT-104 Keyboard Udev Rules
# 1. Allow unprivileged access to USB HID raw interfaces (0c45:8009 wired mode)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", MODE="0666"

# 2. Automatically apply scancode-to-keycode remapping on 2.4G wireless dongle (05ac:024f)
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="024f", RUN+="/usr/bin/lt104-remap-keys /dev/input/%k"

# 3. Automatically apply scancode-to-keycode remapping on wired connection (0c45:8009)
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", RUN+="/usr/bin/lt104-remap-keys /dev/input/%k"
